<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

    </FrameLayout>

    <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/primary_gradient_dark"
            android:theme="@style/AppTheme.AppBarOverlay">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/toolbar_layout"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            app:contentScrim="@android:color/transparent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:statusBarScrim="@android:color/transparent"
            app:titleEnabled="false">

            <!--封面图片-->

            <ImageView
                android:id="@+id/imageview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fitsSystemWindows="true"
                android:scaleType="centerCrop"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.7" />

            <View
                android:id="@+id/banner_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/colorBlack40"
                android:visibility="gone"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.7" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/white"
                android:visibility="visible">

            </ProgressBar>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_gravity="bottom"
                android:background="@android:color/transparent"
                android:visibility="invisible"
                app:tabIndicatorColor="@android:color/white"
                app:tabIndicatorFullWidth="false"
                app:tabSelectedTextColor="@android:color/white"
                app:tabTextColor="@color/colorWhite60" />

            <!--顶部钉住的区域：包含状态栏占位和Toolbar-->
            <LinearLayout
                android:id="@+id/top_bar_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_collapseMode="pin">

                <View
                    android:id="@+id/status_bar_spacer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp" />

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    app:navigationIcon="@drawable/ic_arrow_back_white_shadow">

                    <TextView
                        android:id="@+id/toolbar_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal|center_vertical"
                        android:layout_marginEnd="@dimen/sixteen_dp"
                        android:alpha="0.0"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/string_422"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/follow_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:visibility="invisible">

                            <ceui.loxia.ProgressTextButton
                                android:id="@+id/follow"
                                style="@style/BlueShiningButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:paddingHorizontal="16dp"
                                android:text="@string/follow"
                                android:visibility="gone"
                                app:ptb_progress_stroke_width="3dp"
                                app:ptb_progress_width="14dp" />

                            <ceui.loxia.ProgressTextButton
                                android:id="@+id/unfollow"
                                style="@style/RedShiningButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:paddingHorizontal="16dp"
                                android:text="@string/unfollow"
                                android:visibility="gone"
                                app:ptb_progress_stroke_width="3dp"
                                app:ptb_progress_width="14dp" />
                        </FrameLayout>

                        <ImageView
                            android:id="@+id/more_action"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:padding="9dp"
                            android:src="@drawable/ic_more_vert_black_24dp"
                            android:visibility="invisible" />
                    </LinearLayout>
                </androidx.appcompat.widget.Toolbar>
            </LinearLayout>

            <!-- 用户信息放在最后，确保 Z 轴最高，点击不受阻 -->
            <LinearLayout
                android:id="@+id/center_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:visibility="invisible">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/user_head"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="32dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Circle"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1dp" />

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/twelve_dp">

                    <TextView
                        android:id="@+id/user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/vip_image"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/six_dp"
                        android:layout_toEndOf="@+id/user_name"
                        android:src="@mipmap/premium_user" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/twelve_dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/follow_s"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/string_145"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/follow_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="@dimen/sixteen_dp"
                        android:layout_marginTop="@dimen/six_dp"
                        android:layout_marginEnd="@dimen/sixteen_dp"
                        android:background="@color/white" />

                    <TextView
                        android:id="@+id/p_friend_s"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/string_147"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/p_friend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
